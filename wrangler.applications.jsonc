{
  "name": "p4a-applications",
  "main": "src/application-intake.mjs",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./application-public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "APPLICATIONS",
      "database_name": "p4a-applications",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations/applications"
    }
  ],
  "ratelimits": [
    { "name": "APPLY_RATE_LIMIT", "namespace_id": "20412612", "simple": { "limit": 8, "period": 60 } }
  ]
}
