{
  "name": "p4a-membership-pilot",
  "main": "src/pilot-worker.mjs",
  "compatibility_date": "2026-11-07",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "PILOT_MODE": "fictional"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "PILOT_DB",
      "database_name": "p4a-membership-pilot",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations/pilot"
    }
  ]
}
